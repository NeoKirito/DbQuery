<!doctype html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : '综合查询' %></title>
    <link href="/static/vendor/bootstrap.min.css" rel="stylesheet">
    <link href="/static/vendor/dataTables.bootstrap5.min.css" rel="stylesheet">
    <link href="/static/css/style.css" rel="stylesheet">
    <% if (typeof extra_css !== 'undefined') { %><%- extra_css %><% } %>
</head>
<body class="<%= embed_mode ? 'embed-mode' : 'standalone-mode' %><%= sidebar_hidden ? ' sidebar-hidden-mode' : '' %>"
      data-page="<%= page_name || 'app' %>"
      data-embed-mode="<%= embed_mode ? '1' : '0' %>"
      data-sidebar-hidden="<%= sidebar_hidden ? '1' : '0' %>">
    <main class="app-body" aria-label="综合查询内容区">
