[meta]
title = 人员明细嵌入示例
group = 示例
description = 用于验证 Frontend Embed V1 的公开表单 ID、体检号预填与服务端参数门控；不读取业务表。
web_enabled = true
id = person-detail

[params]
tjh = 体检号 | text | | required | placeholder=由宿主系统传入体检号 | external_allowed=true
source = 来源 | hidden | DBQuery

[sql]
SELECT
    N'Frontend Embed V1 已建立 DBQuery Session。' AS 使用说明,
    N'{tjh}' AS 体检号,
    N'{source}' AS 服务端固定来源,
    CONVERT(varchar(19), GETDATE(), 120) AS 当前数据库时间
