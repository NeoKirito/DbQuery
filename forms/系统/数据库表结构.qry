[meta]
title = 数据库表信息
group = 系统
description = 查询当前数据库中所有用户表及其字段信息（无需参数，直接运行）

[params]
# 本表单无查询参数，直接点击"执行查询"即可

[sql]
SELECT
    t.TABLE_SCHEMA          AS 架构,
    t.TABLE_NAME            AS 表名,
    c.COLUMN_NAME           AS 字段名,
    c.ORDINAL_POSITION      AS 字段序号,
    c.DATA_TYPE             AS 数据类型,
    ISNULL(CAST(c.CHARACTER_MAXIMUM_LENGTH AS VARCHAR), '') AS 长度,
    c.IS_NULLABLE           AS 允许空,
    ISNULL(c.COLUMN_DEFAULT, '') AS 默认值,
    ISNULL(CAST(ep.value AS NVARCHAR(4000)), '') AS 字段备注
FROM INFORMATION_SCHEMA.TABLES t
    JOIN INFORMATION_SCHEMA.COLUMNS c
        ON t.TABLE_NAME = c.TABLE_NAME AND t.TABLE_SCHEMA = c.TABLE_SCHEMA
    LEFT JOIN sys.columns sc
        ON sc.object_id = OBJECT_ID(t.TABLE_SCHEMA + '.' + t.TABLE_NAME)
       AND sc.name = c.COLUMN_NAME
    LEFT JOIN sys.extended_properties ep
        ON ep.major_id = sc.object_id
       AND ep.minor_id = sc.column_id
       AND ep.name = 'MS_Description'
WHERE t.TABLE_TYPE = 'BASE TABLE'
ORDER BY t.TABLE_SCHEMA, t.TABLE_NAME, c.ORDINAL_POSITION
